{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(python *)",
      "PowerShell(python *)",
      "Bash(./tools/*)",
      "Bash(powershell *)",
      "PowerShell(.\\tools\\*)",
      "PowerShell(& .\\tools\\*)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-CimInstance *)",
      "PowerShell(Remove-Item *)",
      "Bash(\"/c/Program Files \\(x86\\)/Steam/steamapps/common/Factorio/bin/x64/factorio.exe\" *)",
      "Read(//c/Program Files \\\\\\(x86\\\\\\)/Steam/steamapps/common/Factorio/**)",
      "WebFetch(domain:mods.factorio.com)",
      "WebFetch(domain:lua-api.factorio.com)",
      "WebFetch(domain:wiki.factorio.com)",
      "WebFetch(domain:forums.factorio.com)",
      "WebFetch(domain:www.reddit.com)",
      "Skill(update-config)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Reading anything under the Steam Factorio install, factorio-data/, or factorio-docs/",
      "Deleting or regenerating build output: src/graphics/icons, tools/tycoon_*.zip, factorio-docs/html, and the scratchpad directory",
      "Fetching Factorio documentation and mod-portal pages"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"Shell is pre-approved in this project\"}}'"
          }
        ]
      }
    ]
  }
}
